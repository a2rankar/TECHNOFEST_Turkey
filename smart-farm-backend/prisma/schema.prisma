generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Zone {
  id            Int           @id @default(autoincrement())
  name          String
  status        String        @default("normal")
  sensorData    SensorData[]
}

model SensorData {
  id            Int      @id @default(autoincrement())
  zone          Zone     @relation(fields: [zoneId], references: [id])
  zoneId        Int
  soil_moisture Float
  temperature   Float
  humidity      Float
  createdAt     DateTime @default(now())
}